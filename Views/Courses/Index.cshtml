@using Microsoft.AspNetCore.Identity;
@using MVCWebApp.Models;
@using MVCWebApp.Data;

@model List<Course>
@{
    ViewData["Title"] = "Courses";
}

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<!-- Notification Section -->
@if (TempData["NotificationMessage"] != null)
{
    var alertClass = TempData["NotificationType"]?.ToString() == "success" ? "alert-success" : "alert-danger";
    <div class="alert @alertClass alert-dismissible fade show" role="alert">
        @TempData["NotificationMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (User.IsInRole("Moderator"))
{
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Courses</h4>
                    <a class="btn btn-primary btn-round ms-auto"
                       href="@Url.Action("Create", "Courses")">
                        <i class="fa fa-plus"></i>
                        Add new course
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table id="add-row"
                       class="display table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Course name</th>
                            <th>Lecturer</th>
                            <th>StartDate</th>
                            <th>Tuition Fee (VND)</th>
                            <th>Slots</th>
                            <th style="width: 15%">Action</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>Course name</th>
                            <th>Lecturer</th>
                            <th>StartDate</th>
                            <th>Tuition Fee (VND)</th>
                            <th>Slots</th>
                            <th>Action</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CourseName</td>
                                <td>@item.Lecturer</td>
                                <td>@item.StartDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.TuitionFee</td>
								<td>@item.StudentLimit</td>
                                <td>
                                    <div class="form-button-action">
                                        <a href="@Url.Action("Edit", "Enrollments", new { courseId = item.CourseId })"
                                           class="btn btn-link"
                                           data-original-title="Edit Enrollments">
                                            <i class="fa fa-list"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", "Courses", new { id = item.CourseId})"
                                           class="btn btn-link"
                                           data-original-title="Edit Courses">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "Courses", new { id = item.CourseId})"
                                           class="btn btn-link"
                                           data-original-title="Remove"
                                           onclick="return confirm('Are you sure you want to delete this?')">
                                            <i class="fa fa-times"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Student"))
{
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Courses</h4>
                    <form class="d-flex ms-auto" asp-action="Index" asp-controller="Courses">
                        <input type="text" class="form-control" name="searchString" placeholder="Search..." />
                        <p class="text-muted ms-2 col-2">Sort by:</p>
                        <select class="form-select ms-2" name="sortBy">
                            <option value="CourseName">Course Name</option>
                            <option value="Lecturer">Lecturer</option>
                        </select>
                        <button type="submit" class="btn btn-primary btn-round ms-2">
                            <i class="fa fa-search"></i>
                        </button>
                    </form>
                </div>
            </div>

            <div class="table-responsive">
                <table id="add-row"
                       class="display table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Course name</th>
                            <th>Lecturer</th>
                            <th>StartDate</th>
                            <th>Tuition Fee (VND)</th>
                            <th>Slots</th>
                            <th style="width: 10%">Action</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>Course name</th>
                            <th>Lecturer</th>
                            <th>StartDate</th>
                            <th>Tuition Fee (VND)</th>
                            <th>Slots</th>
                            <th>Action</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CourseName</td>
                                <td>@item.Lecturer</td>
                                <td>@item.StartDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.TuitionFee</td>
                                <td>@item.StudentLimit</td>
                                <td>
                                    <div class="form-button-action">
                                        <form asp-action="Enroll" asp-controller="Enrollments" method="post">
                                            <input type="hidden" name="courseId" value="@item.CourseId" />                                           
                                            <button type="submit" class="btn btn-link text-primary"
                                                    onclick="return confirm('Are you sure you want to enroll in this course?')">
                                                Enroll
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

