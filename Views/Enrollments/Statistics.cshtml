@using Microsoft.AspNetCore.Identity
@using MVCWebApp.Models
@using MVCWebApp.Data

@{
    ViewData["Title"] = "Statistics";
}

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<!-- Notification Section -->
@if (TempData["NotificationMessage"] != null)
{
    var alertClass = TempData["NotificationType"]?.ToString() == "success" ? "alert-success" :
                     TempData["NotificationType"]?.ToString() == "info" ? "alert-info" : "alert-danger";
    <div class="alert @alertClass alert-dismissible fade show" role="alert">
        @TempData["NotificationMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center">
                <h4 class="card-title">Statistics</h4>
                <a class="btn btn-primary btn-round ms-auto" href="@Url.Action("Index", "Courses")">
                    <i class="fa fa-arrow-left"></i>
                    Back to Courses
                </a>
            </div>
        </div>

        <div class="card-body">
            <!-- Summary Statistics -->
            <div class="row">
                <div class="col-md-4">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title">Total Students</h5>
                            <p class="card-text">@ViewBag.TotalStudents</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">Total Courses</h5>
                            <p class="card-text">@ViewBag.TotalCourses</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title">Total Enrollments</h5>
                            <p class="card-text">@ViewBag.TotalEnrollments</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart Section -->
            <div class="mt-4">
                <div class="d-flex align-items-center mb-3">
                    <h5 class="me-3">Courses Started Per Month (@ViewBag.SelectedYear)</h5>
                    <form asp-action="Statistics" method="get" class="d-flex">
                        <select name="year" class="form-select me-2" onchange="this.form.submit()">
                            @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 5; y++)
                            {
                                if (ViewBag.SelectedYear == y)
                                {
                                    <option value="@y" selected>@y</option>
                                }
                                else
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        </select>
                    </form>
                </div>
    <canvas id="myChart"></canvas>
</div>

            <!-- Enrollments Per Course -->
            <div class="mt-4">
                <h5>Enrollments Per Course</h5>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Course Name</th>
                                <th>Enrollment Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.EnrollmentsPerCourse != null && ((List<Dictionary<string, object>>)ViewBag.EnrollmentsPerCourse).Any())
                            {
                                foreach (var item in (List<Dictionary<string, object>>)ViewBag.EnrollmentsPerCourse)
                                {
                                    <tr>
                                        <td>@item["CourseName"]</td>
                                        <td>@item["Count"]</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">No enrollments available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Recent Enrollments -->
            <div class="mt-4">
                <h5>Recent Enrollments (Last 10)</h5>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Student Name</th>
                                <th>Course Name</th>
                                <th>Enrollment Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RecentEnrollments != null && ((List<Enrollment>)ViewBag.RecentEnrollments).Any())
                            {
                                foreach (var item in (List<Enrollment>)ViewBag.RecentEnrollments)
                                {
                                    var userName = ((Dictionary<Guid, string>)ViewBag.UserNames)[item.StudentId];
                                    var courseName = ((Dictionary<Guid, string>)ViewBag.Courses)[item.CourseId];
                                    <tr>
                                        <td>@userName</td>
                                        <td>@courseName</td>
                                        <td>@item.EnrollmentDate.ToString("dd-MM-yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3">No recent enrollments available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section styles {
    <link rel="stylesheet" href="..\..\wwwroot\css\bootstrap.min.css" />
    <link rel="stylesheet" href="..\..\wwwroot\css\plugins.min.css" />
    <link rel="stylesheet" href="..\..\wwwroot\css\datatables.min.css" />
    <link rel="stylesheet" href="..\..\wwwroot\css\jquery-scrollbar.css" />
    <link rel="stylesheet" href="..\..\wwwroot\css\kaiadmin.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
}

@section Scripts {
    <script src="..\..\wwwroot\js/core\jquery-3.7.1.min.js"></script>
    <script src="..\..\wwwroot\js/core\popper.min.js"></script>
    <script src="..\..\wwwroot\js/core\bootstrap.min.js"></script>
    <script src="..\..\wwwroot/js\plugin\jquery-scrollbar\jquery.scrollbar.min.js"></script>
    <script src="..\..\wwwroot/js\plugin\datatables\datatables.min.js"></script>
    <script src="..\..\wwwroot/js\kaiadmin.min.js"></script>
    <script src="..\..\wwwroot\js\plugin\webfont\webfont.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('myChart');

        // Get the data from ViewBag
        const coursesStartedPerMonth = @Html.Raw(Json.Serialize(ViewBag.CoursesStartedPerMonth)); // mao into a JavaScript array.

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: [
                    'Jan',
                    'Feb',
                    'Mar',
                    'Apr',
                    'May',
                    'Jun',
                    'Jul',
                    'Aug',
                    'Sep',
                    'Oct',
                    'Nov',
                    'Dec'
                ],
                datasets: [{
                    label: 'Number of Courses Started',
                    data: coursesStartedPerMonth,
                    borderWidth: 1,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Number of Courses'
                        }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Month'
                        }
                    }
                }
            }
        });
    </script>
}